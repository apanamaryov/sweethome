[Unit]
Description=Inverter Monitor (SK-5500P-48L, local, no cloud)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/inverter-monitor/server
EnvironmentFile=-/home/pi/inverter-monitor/server/.env
ExecStart=/usr/local/bin/node dist/index.js
Restart=always
RestartSec=5
# Give access to serial/HID devices without extra groups juggling:
# the 'pi' user is typically already in 'dialout' and 'plugdev'.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=inverter-monitor

[Install]
WantedBy=multi-user.target
