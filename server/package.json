{
  "name": "@inverter/server",
  "version": "1.0.0",
  "private": true,
  "description": "Local monitoring and control for an ISolar/EASUN SMG II hybrid inverter (SK-5500P-48L) over Modbus RTU / RS232. No cloud.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "INVERTER_TRANSPORT=mock tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "check": "tsx scripts/selfcheck.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@inverter/shared": "1.0.0",
    "express": "^4.19.2",
    "mqtt": "^5.10.1",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5"
  },
  "license": "MIT"
}
