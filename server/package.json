{
  "name": "@sweethome/server",
  "version": "1.0.0",
  "private": true,
  "description": "Local monitoring and control for an ISolar/EASUN SMG II hybrid inverter (SK-5500P-48L) over Modbus RTU / RS232. No cloud.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "INVERTER_TRANSPORT=mock tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "check": "jest",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@sweethome/inverter-mcp": "1.0.0",
    "@sweethome/inverter-shared": "1.0.0",
    "@sweethome/shared": "1.0.0",
    "express": "^4.19.2",
    "mqtt": "^5.10.1",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.5.10",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5"
  },
  "license": "MIT"
}
