# Copy to .env and adjust as needed.

# HTTP server
PORT=3000
HOST=0.0.0.0

# Transport: auto | serial | mock
#   auto  - try serial, then fall back to demo data
#   serial- force serial (set INVERTER_SERIAL_DEVICE)
#   mock  - always use simulated demo data
INVERTER_TRANSPORT=auto

# For serial transport. Leave empty for auto-pick (/dev/serial/by-id, ttyUSB, ttyACM).
INVERTER_SERIAL_DEVICE=
# SMG II talks Modbus RTU at 9600 baud (8N1).
INVERTER_BAUD=9600
# Modbus slave id — настройка №25 «Modbus ID» в меню инвертора (обычно 1).
MODBUS_SLAVE_ID=1

# Polling / timeouts
POLL_INTERVAL_MS=5000
COMMAND_TIMEOUT_MS=3000

# Fall back to demo data when no inverter is found (true/false)
ALLOW_MOCK=true

# Master switch for write/control commands (true/false).
# Set to false to run in read-only monitoring mode (can never be unlocked).
ALLOW_CONTROL=true

# Start in read-only (locked) mode; a write requires an explicit unlock first.
# This is the "read settings but never overwrite until I need to" safeguard.
STARTUP_LOCKED=true

# Re-engage the lock automatically after each successful write (true/false).
AUTO_RELOCK=true

# Where to persist the captured settings baseline.
DATA_DIR=data

# --- Авторизация (всегда включена) ---
# Пользователи и пароли хранятся в data/auth.db. При первом старте создаются
# admin/admin и user/user — оба обязаны сменить пароль при первом входе.
# Забыли пароль: cd server && npx tsx scripts/reset-password.ts <username> <newpass>
AUTH_SESSION_TTL_DAYS=30

# --- Home Assistant / MQTT integration ---
# Leave MQTT_URL empty to disable. Set it to your broker to publish sensors with
# Home Assistant auto-discovery (entities appear in HA automatically).
# Example: mqtt://user:pass@broker-host:1883  (or mqtts:// for TLS)
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
# Topic root for state/command topics.
MQTT_BASE_TOPIC=inverter
# Home Assistant discovery prefix (must match HA's MQTT integration setting).
MQTT_DISCOVERY_PREFIX=homeassistant
# Stable device id used in topics and entity unique_ids.
MQTT_NODE_ID=sk5500p48l
MQTT_DEVICE_NAME=Inverter SK-5500P-48L
# Expose writable HA controls (select/number). These bypass the UI read-only
# lock, so enabling this is itself the authorization to allow writes from HA.
MQTT_ENABLE_CONTROL=false

# --- Статистика (SQLite через node:sqlite, файл data/stats.db) ---
# STATS_ENABLED=true
# STATS_RAW_DAYS=30        # retention сырых 5-сек снапшотов, дней
# STATS_MINUTE_DAYS=730    # retention поминутных агрегатов, дней

# Окно солнечного дня: порог мощности PV (Вт) и устойчивость (мин)
STATS_SOLAR_THRESHOLD_W=200
STATS_SOLAR_DWELL_MIN=15

# MCP endpoint for LLM agents (same Bearer auth as /api)
MCP_ENABLED=true
MCP_MAX_SESSIONS=8

# --- Видеонаблюдение (модуль cctv) ---
# Список камер: <имя>=<ip>[,<имя>=<ip>,...]. Путь RTSP у камер фиксированный
# (live/ch00_0) и в конфиге не задаётся — см. modules/cctv/CLAUDE.md.
# Пусто (по умолчанию) — модуль стартует, но ничего не делает: удобно для
# npm run dev на машине без камер.
CCTV_ENABLED=true
CCTV_CAMERAS=
# Пример: CCTV_CAMERAS=drive=<camera-ip>,yard=<camera-ip>

# Точка монтирования видео на Pi — отдельная от бэкапного /mnt/rancho-backup,
# готовится руками один раз (fstab, права пользователя sweethome).
CCTV_STORAGE_DIR=/mnt/cctv
# Квота архива, ГБ. При приближении к пределу удаляются самые старые сегменты.
CCTV_QUOTA_GB=500
# Длина сегмента записи, секунд.
CCTV_SEGMENT_SEC=60
# Путь к бинарнику ffmpeg — внешняя зависимость, устанавливается на Pi вручную
# (sudo apt install ffmpeg), не через npm.
CCTV_FFMPEG=ffmpeg
# Сколько секунд процесс живого просмотра живёт без зрителей, прежде чем погаснуть.
CCTV_LIVE_IDLE_SEC=15
# Подписка на события движения по ONVIF. На момент проектирования не
# подтверждено, что камеры их шлют — при отсутствии событий лента архива
# просто остаётся без меток, всё остальное работает как есть.
CCTV_MOTION_EVENTS=true
# Предел интервала для скачивания куска архива, минут.
CCTV_DOWNLOAD_MAX_MIN=30

# --- Сушилка (modules/dryer) ---
# DRYER_ENABLED=false выключает модуль целиком (нет сушилки — нет и раздела в health).
DRYER_ENABLED=true
# mqtt — живая нода через брокер; mock — симулятор (npm run dev форсит mock).
DRYER_TRANSPORT=mqtt
DRYER_MQTT_URL=mqtt://127.0.0.1:1883
DRYER_MQTT_USER=dryer-service
DRYER_MQTT_PASS=
DRYER_MQTT_PREFIX=dryer
